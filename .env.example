# ─────────────────────────────────────────────────────────────
# Actitud Alfa 360 — variables de entorno
# En Vercel: Project → Settings → Environment Variables, con su alcance:
#   Production (rama main) y Preview (rama develop = staging). Nunca "todos" para llaves.
# Nunca subas un .env real a GitHub.
# ─────────────────────────────────────────────────────────────

# staging | production   (staging = rama develop: noindex, Stripe en modo test)
# El acceso a staging lo cierra Vercel (Deployment Protection), no una variable.
# El servidor no arranca si APP_ENV no cuadra con VERCEL_ENV (que pone Vercel solo).
APP_ENV=staging
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_SITE_URL=https://actitudalfa360-git-develop-techbuilddreams.vercel.app

# Stripe — llave RESTRINGIDA (rk_test_ en staging, rk_live_ en producción) con permisos Write en:
#   Checkout Sessions · Products · Prices · Shipping Rates   (nada más)
STRIPE_SECRET_KEY=
# Webhook → https://<dominio>/api/webhooks/stripe
#   Staging está protegido: el webhook de Stripe en modo test lleva el secreto de
#   "Protection Bypass for Automation" → ...?x-vercel-protection-bypass=<secreto>
# Eventos: checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false

# Base de datos (obligatoria en staging y producción). Paso 2: pasa a Supabase Postgres.
DATABASE_URL=mysql://usuario:contraseña@localhost:3306/base
DB_POOL_SIZE=5

# Envío fijo por pedido (centavos)
SHIPPING_FLAT_CENTS=899

# Correo. Paso 3: SMTP se reemplaza por Resend (el SMTP de Hostinger ya no existe).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hola@actitudalfa360.com
SMTP_PASSWORD=
MAIL_FROM=Actitud Alfa 360 <hola@actitudalfa360.com>
# A dónde te llega el aviso de cada venta
ORDER_NOTIFY_EMAIL=

# Printify: crear pedido EN ESPERA al recibir el pago (no se manda a producción solo)
PRINTIFY_AUTO_ORDER=false
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=

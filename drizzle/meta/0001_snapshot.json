          "value": "\"orders\".\"currency\" = 'usd'"
        },
        "orders_lines_ck": {
          "name": "orders_lines_ck",
          "value": "CASE WHEN jsonb_typeof(\"orders\".\"lines\") = 'array' THEN jsonb_array_length(\"orders\".\"lines\") > 0 ELSE false END"
        },
        "orders_amounts_ck": {
          "name": "orders_amounts_ck",
          "value": "(\"orders\".\"subtotal_cents\" = 0 AND \"orders\".\"discount_cents\" = 0 AND \"orders\".\"shipping_cents\" = 0 AND \"orders\".\"tax_cents\" = 0) OR \"orders\".\"subtotal_cents\"::bigint + \"orders\".\"shipping_cents\" + \"orders\".\"tax_cents\" = \"orders\".\"total_cents\"::bigint + \"orders\".\"discount_cents\""
        },
        "orders_processing_claim_ck": {
          "name": "orders_processing_claim_ck",
          "value": "\"orders\".\"status\" <> 'fulfillment_processing' OR (\"orders\".\"claimed_at\" IS NOT NULL AND \"orders\".\"claim_token\" IS NOT NULL)"
